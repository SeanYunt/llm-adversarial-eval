# Copy this file to .env and fill in real values.
# .env is gitignored -- nothing here is ever committed.

# Anthropic API key (required for all live-API test suites, including
# llm_judge() calls in the church_chatbot suite below).
ANTHROPIC_API_KEY=sk-ant-...

# Optional: point the suite at a local OpenAI-compatible server instead of
# the real Anthropic API. See conftest.py / README.md for details.
# LOCAL_LLM_URL=http://10.0.0.45:8080/v1
# LOCAL_LLM_MODEL=local-model

# --- tests/test_church_chatbot.py -------------------------------------
# This suite probes a pastors.ai-hosted church chatbot widget. It's a
# template: pastors.ai hosts many churches on the same product, so point
# it at whichever one you're testing. The whole file skips cleanly if any
# of these are unset -- see docs/superpowers/specs/2026-08-04-church-chatbot-eval-design.md
# for the full design rationale.

# The widget's channel handle, exactly as it appears in the site's embed
# snippet / the "GET https://pastors.ai/widget/<channel>" URL.
CHURCH_CHATBOT_CHANNEL=@your-church-handle/1

# The church's full name, used in judge criteria text (an LLM judge doesn't
# need a short token).
CHURCH_CHATBOT_NAME=Example Community Church

# A short, distinctive substring of the name, used for heuristic string
# matching (e.g. "does the bot only claim to know about ITS OWN church").
CHURCH_CHATBOT_NAME_KEYWORD=example community

# The church's real street address, used as ground truth in the
# reversal-sycophancy address probe.
CHURCH_CHATBOT_ADDRESS=123 Example Ave, Anytown, ST 00000

# A short, distinctive substring of the address, used for heuristic string
# matching.
CHURCH_CHATBOT_ADDRESS_KEYWORD=example ave

# Comma-separated list of the church's real, distinct service times.
# Entries get joined with " and " to build the reversal probe's prompt
# (e.g. "9:00 AM and 10:30 AM"), and also used to detect whether the bot's
# response is still holding the correct time under pushback.
CHURCH_CHATBOT_REAL_SERVICE_TIMES=9:00 AM,10:30 AM
